CTA_ENV=onprem
CTA_HOST=127.0.0.1
CTA_PORT=8000
CTA_PUBLIC_BASE_URL=http://127.0.0.1:8000
CTA_LOCAL_ONLY_MODE=true
CTA_ALLOW_CLOUD_LLM=false
CTA_LLM_PROVIDER=openai_compatible_local
CTA_LLM_MODEL=mlx-community/Qwen3.5-4B-MLX-4bit
CTA_LLM_BASE_URL=http://127.0.0.1:8093/v1
CTA_VISION_PROVIDER=local_vlm
CTA_VISION_MODEL=mlx-community/Qwen3-VL-4B-Instruct-4bit
CTA_VISION_BASE_URL=http://127.0.0.1:8091
CTA_VISION_API_STYLE=openai_compatible
CTA_LLM_TIMEOUT_SECONDS=240
CTA_VISION_TIMEOUT_SECONDS=240
CTA_ENABLE_LOCAL_OCR=false
CTA_ENABLE_LOCAL_VLM=true
CTA_ENABLE_AUTH=true
CTA_ENABLE_ADMIN=true
CTA_ENABLE_PROJECTS=true
CTA_ENABLE_BRANDBOOKS=true
CTA_ENABLE_ADVANCED_EXPORTS=true
CTA_SECRET_KEY=REQUIRED_CHANGE_ME_WITH_64_RANDOM_CHARACTERS
CTA_SESSION_COOKIE_NAME=cta_session
CTA_SESSION_TTL_HOURS=12
CTA_PASSWORD_MIN_LENGTH=12
CTA_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
CTA_BOOTSTRAP_ADMIN_PASSWORD=REQUIRED_CHANGE_ME_WITH_A_STRONG_PASSWORD
CTA_BOOTSTRAP_ADMIN_NAME="On-Prem Admin"
CTA_TRUSTED_HOSTS=localhost,127.0.0.1
CTA_CORS_ALLOWED_ORIGINS=
CTA_SECURITY_FAIL_CLOSED=true
CTA_SECURITY_HEADERS_ENABLED=true
CTA_DATABASE_URL=sqlite:///./data/db/creative_test_agent.db
CTA_STORAGE_ROOT=./data/storage
CTA_EXPORTS_ROOT=./data/exports
CTA_BACKUP_ROOT=./data/backups
CTA_BACKUP_INCLUDE_UPLOADS=true
CTA_BACKUP_INCLUDE_EXPORTS=true
CTA_LOG_LEVEL=INFO
CTA_LOG_FORMAT=plain
CTA_LOG_FILE=
CTA_ENABLE_PROMPT_TRACING=true
CTA_PROMPT_TRACE_STORE_FULL=false
